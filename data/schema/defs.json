{
  "$id": "defs.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "grid": { "type": "string", "pattern": "^[A-V]-([1-9]|1[0-9]|2[0-4])$" },
    "wookieeUrl": { "type": "string", "pattern": "^https://starwars\\.fandom\\.com/wiki/[^\\s]+$" },
    "url": { "type": "string", "pattern": "^https://[^\\s]+$" },
    "summary": { "type": "string", "minLength": 60, "maxLength": 900 },
    "continuity": { "type": "string", "enum": ["legends", "legends-swtor", "legends-comics", "canon", "both"] },
    "year": { "type": "number", "minimum": -40000, "maximum": 300 },
    "date": {
      "oneOf": [
        { "$ref": "#/definitions/year" },
        {
          "type": "object",
          "required": ["start"],
          "additionalProperties": false,
          "properties": {
            "start": { "$ref": "#/definitions/year" },
            "end": { "$ref": "#/definitions/year" },
            "approx": { "type": "boolean" },
            "uncertainty": { "type": "number", "minimum": 0, "maximum": 5000 }
          }
        }
      ]
    },
    "controlSpec": {
      "oneOf": [
        { "type": "array", "items": { "$ref": "#/definitions/id" } },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "systems": { "type": "array", "items": { "$ref": "#/definitions/id" } },
            "regions": { "type": "array", "items": { "$ref": "#/definitions/id" } },
            "except": { "type": "array", "items": { "$ref": "#/definitions/id" } }
          }
        }
      ]
    },
    "keyframe": {
      "type": "object",
      "required": ["date", "note", "source", "control"],
      "additionalProperties": false,
      "properties": {
        "date": { "$ref": "#/definitions/year" },
        "note": { "type": "string", "minLength": 8 },
        "source": { "$ref": "#/definitions/wookieeUrl" },
        "reset": { "type": "boolean" },
        "control": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/controlSpec" }
        },
        "release": { "$ref": "#/definitions/controlSpec" },
        "suppress": { "type": "array", "items": { "$ref": "#/definitions/id" } }
      }
    },
    "event": {
      "type": "object",
      "required": ["id", "name", "type", "date", "location", "factions", "summary", "source", "continuity"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "type": "string", "minLength": 2 },
        "type": { "type": "string", "enum": ["battle", "war", "campaign", "siege", "political", "founding", "destruction", "discovery", "duel", "treaty", "schism", "disaster", "cultural", "exploration", "massacre", "assassination", "exile", "religious"] },
        "date": { "$ref": "#/definitions/date" },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "system": { "$ref": "#/definitions/id" },
            "region": { "$ref": "#/definitions/id" },
            "note": { "type": "string" }
          },
          "anyOf": [{ "required": ["system"] }, { "required": ["region"] }]
        },
        "factions": { "type": "array", "items": { "$ref": "#/definitions/id" } },
        "summary": { "$ref": "#/definitions/summary" },
        "source": { "$ref": "#/definitions/wookieeUrl" },
        "sources": { "type": "array", "items": { "$ref": "#/definitions/url" } },
        "continuity": { "$ref": "#/definitions/continuity" },
        "importance": { "type": "integer", "minimum": 1, "maximum": 5 },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requires": { "type": "array", "items": { "$ref": "#/definitions/id" } },
            "enables": { "type": "array", "items": { "$ref": "#/definitions/id" } },
            "prevents": { "type": "array", "items": { "$ref": "#/definitions/id" } }
          }
        },
        "latent": { "type": "boolean" },
        "speculative": { "type": "boolean" },
        "basis": { "type": "string", "minLength": 10 },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
