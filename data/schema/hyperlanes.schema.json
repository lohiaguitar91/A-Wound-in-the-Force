{
  "$id": "hyperlanes.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "systems", "summary", "source"],
    "additionalProperties": false,
    "properties": {
      "id": { "$ref": "defs.json#/definitions/id" },
      "name": { "type": "string" },
      "short": { "type": "string" },
      "systems": { "type": "array", "minItems": 2, "items": { "$ref": "defs.json#/definitions/id" } },
      "summary": { "$ref": "defs.json#/definitions/summary" },
      "source": { "$ref": "defs.json#/definitions/wookieeUrl" },
      "major": { "type": "boolean" }
    }
  }
}
