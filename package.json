{
  "name": "galaxy-atlas",
  "private": true,
  "version": "0.1.0",
  "description": "A mobile-first interactive atlas of the Star Wars galaxy (Legends) with time scrubbing and what-if pivots. Personal, non-commercial fan project.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/build-data.mjs && vite",
    "build": "node scripts/build-data.mjs && tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "build:data": "node scripts/build-data.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "fetch:wiki": "node scripts/fetch-wookieepedia.mjs",
    "test": "npm run validate:data && vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "devDependencies": {
    "@playwright/test": "~1.56.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "lighthouse": "^13.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
